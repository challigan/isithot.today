---
/**
 * The Today view (Tomorrow in the evening, from the forecast's next day): answer, verdict, on Hot
 * the UV index, on Wind the Met Office's warnings for a UK gale or storm, and model agreement.
 * Rendered on the server with data (city pages) or in its loading state (home page); the browser
 * script updates the same nodes. Its answer is the page's only h1 whichever view is on screen.
 * The words the script puts in (scripts/app.ts `setText`) go in with set:text, so the markup
 * holds exactly those words. As a child, Prettier puts them on a line of their own once the
 * element's line is long, and the page would hold them with a space either side, which `setText`
 * keeps when the words are the same.
 */
import { COPY, type OutboundLink, type TodayDisplay } from '@isithot/core';
import { glyphFor, listHtml, stripHtml } from '../lib/view';
import UvLine from './UvLine.astro';
import WarningsLine from './WarningsLine.astro';

interface Props {
  /** From core `viewDisplay`. */
  view: TodayDisplay;
  /** The page opens on this view (else it starts hidden, until the views join the scroller). */
  start?: boolean;
  /** It answers for tomorrow. */
  tomorrow?: boolean;
  /** Wind's link to the Met Office's warnings, for a gale or storm in the UK. */
  warnings?: OutboundLink | null;
}

const { view, start = true, tomorrow = false, warnings = null } = Astro.props;
const { models } = view;
---

<section
  class="view"
  id="view-today"
  role="tabpanel"
  aria-labelledby="tab-today"
  data-view="today"
  data-band={view.band ?? undefined}
  data-empty={view.empty ? '' : undefined}
  data-tomorrow={tomorrow ? '' : undefined}
  tabindex="0"
  inert={!start}
  hidden={!start}
>
  <svg
    class="glyph"
    id="glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    data-glyph={view.band ?? ''}
    set:html={glyphFor(view.band)}
  />
  {/*
   * The heading is the question with its answer ("Is it hot in Leeds today? Yes."). The live
   * region holds it and the verdict, so an answer that arrives or changes is read with its
   * question; nothing in it changes from minute to minute.
   */}
  <div aria-live="polite" aria-atomic="true" id="live">
    <h1 class="heading" id="heading">
      <span class="question" id="question" set:text={view.question} />{' '}
      <span
        class="answer"
        id="answer"
        data-long={view.answer.length > 4 ? '' : undefined}
        set:text={view.answer}
      />
    </h1>
    <p class="verdict hold" id="verdict" set:text={view.verdict} />
  </div>
  <p class="detail hold" id="detail" set:text={view.detail} />
  <UvLine id="uv" uv={view.uv} />
  <WarningsLine id="warnings" link={warnings} />

  <section class="models hold" id="models" aria-labelledby="models-h">
    <h2 id="models-h">
      <span id="agree" set:text={models.heading} />
    </h2>
    <p class="sr-only" id="strip-summary" set:text={models.summary} />
    <div class="strip" id="strip" aria-hidden="true" set:html={stripHtml(models)} />
    <div class="scale" aria-hidden="true">
      <span id="smin" set:text={models.min} />
      <span id="smax" set:text={models.max} />
    </div>
    <ul class="list" id="list" set:html={listHtml(models)} />
    <p class="limited" id="limited" hidden={!models.limited}>
      {models.limited ?? COPY.limited}
    </p>
  </section>
</section>
