---
/**
 * The Today view: answer, verdict and model agreement. Rendered on the server with data (city
 * pages) or in its loading state (home page); the browser script updates the same nodes.
 */
import { COPY, type TodayDisplay } from '@isithot/core';
import { glyphFor, listHtml, stripHtml } from '../lib/view';

interface Props {
  /** From core `viewDisplay`. */
  view: TodayDisplay;
}

const { view } = Astro.props;
const { models } = view;
---

<section
  class="view"
  id="view-today"
  role="tabpanel"
  aria-labelledby="tab-today"
  data-view="today"
  data-band={view.band ?? undefined}
  data-empty={view.empty ? '' : undefined}
  tabindex="0"
>
  <svg
    class="glyph"
    id="glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    data-glyph={view.band ?? ''}
    set:html={glyphFor(view.band)}
  />
  <p class="question" id="question">
    {view.question}
  </p>
  <div aria-live="polite" aria-atomic="true" id="live">
    <h1 class="answer" id="answer">
      {view.answer}
    </h1>
    <p class="verdict hold" id="verdict">
      {view.verdict}
    </p>
  </div>
  <p class="detail hold" id="detail">
    {view.detail}
  </p>

  <section class="models hold" id="models" aria-labelledby="models-h">
    <h2 id="models-h">
      <span id="agree">{models.heading}</span>
    </h2>
    <p class="sr-only" id="strip-summary">
      {models.summary}
    </p>
    <div class="strip" id="strip" aria-hidden="true" set:html={stripHtml(models)} />
    <div class="scale" aria-hidden="true">
      <span id="smin">{models.min}</span>
      <span id="smax">{models.max}</span>
    </div>
    <ul class="list" id="list" set:html={listHtml(models)} />
    <p class="limited" id="limited" hidden={!models.limited}>
      {models.limited ?? COPY.limited}
    </p>
  </section>
</section>
