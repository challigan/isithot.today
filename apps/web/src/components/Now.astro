---
/**
 * The Now view: the blended forecast for the current time and the next few hours, with on Hot the
 * UV index and on Wind where the wind blows from. Words the script puts in go in with set:text, as
 * in Today.astro.
 */
import type { NowDisplay, OutboundLink } from '@isithot/core';
import { glyphFor, hoursHtml } from '../lib/view';
import DirectionLine from './DirectionLine.astro';
import UvLine from './UvLine.astro';
import WarningsLine from './WarningsLine.astro';

interface Props {
  /** From core `viewDisplay`. */
  view: NowDisplay;
  /** The page opens on this view (else it starts hidden, until the views join the scroller). */
  start?: boolean;
  /** Wind's link to the Met Office's warnings, for a gale or storm in the UK. */
  warnings?: OutboundLink | null;
}

const { view, start = false, warnings = null } = Astro.props;
---

<section
  class="view view-now"
  id="view-now"
  role="tabpanel"
  aria-labelledby="tab-now"
  data-view="now"
  data-band={view.band ?? undefined}
  data-empty={view.empty ? '' : undefined}
  tabindex="0"
  inert={!start}
  hidden={!start}
>
  <svg
    class="glyph"
    id="now-glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    data-glyph={view.band ?? ''}
    set:html={glyphFor(view.band)}
  />
  {/* The start view's heading is the page's main one, as scripts/views.ts makes it. */}
  <h2 class="heading" id="now-heading" aria-level={start ? '1' : undefined}>
    <span class="question" id="now-question" set:text={view.question} />{' '}
    <span
      class="answer"
      id="now-answer"
      data-long={view.answer.length > 4 ? '' : undefined}
      set:text={view.answer}
    />
  </h2>
  <p class="verdict hold" id="now-verdict" set:text={view.verdict} />
  <p class="detail hold" id="now-detail" set:text={view.detail} />
  <DirectionLine direction={view.direction} />
  <UvLine id="now-uv" uv={view.uv} />
  <WarningsLine id="now-warnings" link={warnings} />
  <section class="ahead hold" aria-labelledby="now-h">
    <h2 id="now-h" set:text={view.heading} />
    <ul class="list" id="now-hours" set:html={hoursHtml(view.items)} />
  </section>
</section>
