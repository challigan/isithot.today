---
/** The Now view: the blended forecast for the current time and the next few hours. */
import type { NowDisplay } from '@isithot/core';
import { glyphFor, hoursHtml } from '../lib/view';
import UvLine from './UvLine.astro';

interface Props {
  /** From core `viewDisplay`. */
  view: NowDisplay;
  /** The page opens on this view (else it starts hidden, until the views join the scroller). */
  start?: boolean;
}

const { view, start = false } = Astro.props;
---

<section
  class="view view-now"
  id="view-now"
  role="tabpanel"
  aria-labelledby="tab-now"
  data-view="now"
  data-band={view.band ?? undefined}
  data-empty={view.empty ? '' : undefined}
  tabindex="0"
  inert={!start}
  hidden={!start}
>
  <svg
    class="glyph"
    id="now-glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    data-glyph={view.band ?? ''}
    set:html={glyphFor(view.band)}
  />
  {/* The start view's heading is the page's main one, as scripts/views.ts makes it. */}
  <h2 class="heading" id="now-heading" aria-level={start ? '1' : undefined}>
    <span class="question" id="now-question">
      {view.question}
    </span>{' '}
    <span class="answer" id="now-answer" data-long={view.answer.length > 4 ? '' : undefined}>
      {view.answer}
    </span>
  </h2>
  <p class="verdict hold" id="now-verdict">
    {view.verdict}
  </p>
  <p class="detail hold" id="now-detail">
    {view.detail}
  </p>
  <UvLine id="now-uv" uv={view.uv} />
  <section class="ahead hold" aria-labelledby="now-h">
    <h2 id="now-h">{view.heading}</h2>
    <ul class="list" id="now-hours" set:html={hoursHtml(view.items)} />
  </section>
</section>
