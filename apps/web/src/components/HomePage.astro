---
/**
 * The home page of each site: isithot.today (/), isitwet.today (/wet), willitsnow.today (/snow) and
 * isitwindy.today (/wind), each served at / on its own domain by the edge function. Sent in its
 * loading state, already asking the page's own question; the browser fills in the answer for where
 * the visitor is. The answer is never rendered on the server: search engines crawl from the US and
 * would index a US town's. They read the introduction under it instead.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Views from './Views.astro';
import AdSlot from './AdSlot.astro';
import Footer from './Footer.astro';
import Intro from './Intro.astro';
import SearchSheet from './SearchSheet.astro';
import { CACHE, LOADING_PALETTE, SITES, TOMORROW_FROM_HOUR, type Topic } from '@isithot/core';
import { websiteLd } from '../lib/seo';
import { lastKey } from '../lib/topics';

interface Props {
  /** The site the page belongs to, and the topic it opens on. */
  topic: Topic;
}

const { topic } = Astro.props;
// Each site remembers its own last answer; all are saved and read the same way.
const key = lastKey(topic);
const version = CACHE.snapshotVersion;
const maxAge = CACHE.localAnswerMaxAgeMs;
const evening = TOMORROW_FROM_HOUR;
---

<Base
  topic={topic}
  canonical={`${SITES[topic].url}/`}
  palette={LOADING_PALETTE}
  jsonLd={websiteLd(topic)}
>
  <script is:inline slot="head">
    // Start the API request before the main script has downloaded. Mirrors apiUrl() in
    // scripts/app.ts; if they ever disagree the app simply makes its own request.
    (() => {
      try {
        if (location.search) return;
        const get = (k) => JSON.parse(localStorage.getItem(k) || 'null');
        const t = get('isithot:place') || { kind: 'ip' };
        const units = get('isithot:units') || (t.kind === 'ip' ? null : 'c');
        // Wind's own units only once chosen: until then the server picks the place's.
        const windUnits = get('isithot:windUnits');
        const p = new URLSearchParams();
        if (t.kind === 'city') p.set('place', t.slug);
        if (t.kind === 'coords') {
          p.set('lat', String(t.lat));
          p.set('lon', String(t.lon));
          if (t.name) p.set('name', t.name);
          if (t.region) p.set('region', t.region);
          if (t.country) p.set('country', t.country);
          if (t.geonameId) p.set('geonameId', String(t.geonameId));
          if (t.elevation !== undefined) p.set('elevation', String(t.elevation));
          p.set('source', t.source);
        }
        if (units) p.set('units', units);
        if (windUnits === 'mph' || windUnits === 'kmh') p.set('windUnits', windUnits);
        const qs = p.toString();
        const url = '/api/v1/today' + (qs ? '?' + qs : '');
        window.__isithotPrefetch = {
          url,
          response: fetch(url, { headers: { accept: 'application/json' } }),
        };
      } catch {
        // The app will fetch normally.
      }
    })();
  </script>
  <div class="wrap" id="app" data-state="loading" data-mode="home" data-topic={topic}>
    <Header site={topic} />
    <Views data={null} state="loading" topic={topic} />
    <AdSlot />
    <Intro topic={topic} />
    <Footer />
  </div>
  <SearchSheet />
  <script is:inline define:vars={{ key, version, maxAge, evening }}>
    // Paint the last answer instantly (under 3 hours old) before the main script loads. A wet,
    // snow or wind answer is for the rest of the day from when it was worked out: only until the
    // next hour.
    // The page opens on Today, or in the evening at the place on Now with Tomorrow in the middle
    // (scripts/app.ts saveLast): only while that is still the day and slot at the place.
    try {
      const c = location.search ? null : JSON.parse(localStorage.getItem(key) || 'null');
      const at = {};
      if (c && c.tz) {
        const f = new Intl.DateTimeFormat('en-GB', {
          timeZone: c.tz,
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: 'numeric',
          hourCycle: 'h23',
        });
        for (const p of f.formatToParts(Date.now())) at[p.type] = p.value;
      }
      if (
        c &&
        c.v === version &&
        Date.now() - c.savedAt <= maxAge &&
        (!c.until || Date.now() < c.until) &&
        c.date === at.year + '-' + at.month + '-' + at.day &&
        c.slot === (+at.hour >= evening ? 'tomorrow' : 'today')
      ) {
        const s = document.documentElement.style;
        for (const k in c.palette) s.setProperty('--' + k, c.palette[k]);
        document.querySelector('meta[name=theme-color]').setAttribute('content', c.palette.g1);
        document.getElementById('main').innerHTML = c.html;
        // "Now" from a saved answer is out of date; the app works it out again on load.
        if (Date.now() - c.savedAt > 900000) {
          document.getElementById('view-now').setAttribute('data-pending', '');
        }
        document.getElementById('place').textContent = c.place;
        const app = document.getElementById('app');
        app.setAttribute('data-state', 'ready');
        app.setAttribute('data-restored', '1');
        document.title = c.title;
      }
    } catch {
      // No storage or a bad entry: the normal load takes over.
    }
  </script>
  <script>
    import { start } from '../scripts/app';
    start();
  </script>
</Base>
