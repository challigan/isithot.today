---
/**
 * The Hot | Wet | Snow | Wind toggle, the tab bar and the three views (Now | Today | This week) in
 * one horizontal scroller, plus what they share: when the forecast was fetched and the place links
 * (a city page adds its own after them). Today comes first in the markup (it is the page's purpose,
 * its question and answer are the only h1, and the answer is the LCP element) and sits in the
 * middle on screen. In the evening at the place the middle view answers for tomorrow and the page
 * opens on Now (core `showsTomorrow`, `defaultView`).
 */
import {
  COPY,
  outboundLinks,
  updatedTime,
  viewDisplay,
  type DisplayState,
  type NearbyCity,
  type Topic,
  type TodayResponse,
  type View,
} from '@isithot/core';
import TopicToggle from './TopicToggle.astro';
import ViewTabs from './ViewTabs.astro';
import Today from './Today.astro';
import Now from './Now.astro';
import Week from './Week.astro';
import { warningsFor } from '../lib/view';

interface Props {
  data: TodayResponse | null;
  city?: string | null;
  state: DisplayState;
  /** The question the views answer first: the page's own topic. */
  topic?: Topic;
  /** The view the page opens on. */
  start?: View;
  /** The middle view answers for tomorrow. */
  tomorrow?: boolean;
}

const { data, city = null, state, topic = 'hot', start = 'today', tomorrow = false } = Astro.props;
const opts = { city };
const links = outboundLinks(data?.location ?? null);
const nearby: NearbyCity[] = data?.nearby ?? [];
const escape = (text: string): string =>
  text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const nearbyHtml = nearby
  .map((c) => `<a href="/in/${encodeURIComponent(c.slug)}">${escape(c.name)}</a>`)
  .join(', ');
const day = data?.days[0];
const updated = data && day && updatedTime(data.updatedAt, data.location.timezone, day.date);
const today = viewDisplay(data, topic, 'today', state, { ...opts, tomorrow });
const now = viewDisplay(data, topic, 'now', state, opts);
---

{/* The question on screen (scripts/app.ts keeps it up to date as the toggle changes it). */}
<main id="main" tabindex="-1" data-topic={topic}>
  <TopicToggle topic={topic} />
  <ViewTabs start={start} tomorrow={tomorrow} />
  {/*
   * Without an answer (the home page's loading state) the views hold placeholder text, which
   * search results must never quote.
   */}
  <div class="views" id="views" data-nosnippet={state === 'ready' ? undefined : ''}>
    <Today
      view={today}
      start={start === 'today'}
      tomorrow={tomorrow}
      warnings={warningsFor(topic, data, today.empty ? null : today.band)}
    />
    <Now
      view={now}
      start={start === 'now'}
      warnings={warningsFor(topic, data, now.empty ? null : now.band)}
    />
    <Week view={viewDisplay(data, topic, 'week', state, opts)} start={start === 'week'} />
  </div>
  <button class="button retry" id="retry" type="button" hidden={state !== 'error'}>
    {COPY.retry}
  </button>
  <p class="sr-only" id="view-live" aria-live="polite"></p>
  <!-- prettier-ignore -->
  <p class="updated" id="updated" hidden={!updated}>{COPY.updated} <time id="updated-at" datetime={updated ? data?.updatedAt : undefined}>{updated}</time></p>
  <p class="stale" id="stale" hidden={!data?.stale}>
    {COPY.stale}
  </p>
  <!-- prettier-ignore -->
  <p class="more" id="more">{COPY.outboundIntro} <a id="out-0" href={links[0]!.url} target="_blank" rel="noopener">BBC Weather</a>, <a id="out-1" href={links[1]!.url} target="_blank" rel="noopener">Met Office</a> or <a id="out-2" href={links[2]!.url} target="_blank" rel="noopener">AccuWeather</a>.</p>
  <p class="nearby" id="nearby" hidden={nearby.length === 0}>
    {COPY.nearby} <span id="nearby-links" set:html={nearbyHtml} />
  </p>
  <slot />
</main>
