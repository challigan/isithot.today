---
/**
 * The This week view: today and the next six days, with one row per day. Words the script puts in
 * go in with set:text, as in Today.astro.
 */
import type { WeekDisplay } from '@isithot/core';
import { glyphFor, weekHtml } from '../lib/view';

interface Props {
  /** From core `viewDisplay`. */
  view: WeekDisplay;
  /** The page opens on this view (else it starts hidden, until the views join the scroller). */
  start?: boolean;
}

const { view, start = false } = Astro.props;
---

<section
  class="view view-week"
  id="view-week"
  role="tabpanel"
  aria-labelledby="tab-week"
  data-view="week"
  data-band={view.band ?? undefined}
  data-empty={view.empty ? '' : undefined}
  tabindex="0"
  inert={!start}
  hidden={!start}
>
  <svg
    class="glyph"
    id="week-glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    data-glyph={view.band ?? ''}
    set:html={glyphFor(view.band)}
  />
  <h2 class="heading" id="week-heading">
    <span class="question" id="week-question" set:text={view.question} />{' '}
    <span
      class="answer"
      id="week-answer"
      data-long={view.answer.length > 4 ? '' : undefined}
      set:text={view.answer}
    />
  </h2>
  <p class="verdict hold" id="week-verdict" set:text={view.verdict} />
  <p class="detail hold" id="week-detail" set:text={view.detail} />
  <section class="ahead hold" aria-labelledby="week-h">
    <h2 id="week-h" set:text={view.heading} />
    <ul class="days" id="week-days" set:html={weekHtml(view.items)} />
  </section>
</section>
