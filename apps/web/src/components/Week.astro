---
/** The This week view: today and the next six days averaged, with one row per day. */
import { COPY, question, type ApiWeek } from '@isithot/core';
import { GLYPHS, weekHtml } from '../lib/view';

interface Props {
  week: ApiWeek | null;
  city?: string | null;
  state: 'loading' | 'ready' | 'error';
}

const { week, city = null, state } = Astro.props;
const answer =
  state === 'error'
    ? COPY.unavailable
    : state === 'loading'
      ? COPY.checking
      : (week?.answer ?? COPY.notAvailable);
// Placeholders keep the layout steady while loading.
const placeholderDays = Array.from(
  { length: 7 },
  () =>
    '<li><span class="d">Day</span><span class="track" aria-hidden="true"></span><span class="t">00°</span><span class="a">Warm</span></li>',
).join('');
---

<section
  class="view view-week"
  id="view-week"
  role="tabpanel"
  aria-labelledby="tab-week"
  data-view="week"
  data-band={week?.band}
  data-empty={state === 'ready' && !week ? '' : undefined}
  tabindex="0"
  inert
  hidden
>
  <svg
    class="glyph"
    id="week-glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={week ? GLYPHS[week.band] : ''}
  />
  <p class="question" id="week-question">
    {question(city, 'week')}
  </p>
  <h2 class="answer" id="week-answer">
    {answer}
  </h2>
  <p class="verdict hold" id="week-verdict">
    {week?.verdict ?? 'A warm week, not hot.'}
  </p>
  <p class="detail hold" id="week-detail">
    {week?.detail ??
      'Highs average 00°, feels like 00°. Hottest on Wednesday, 00°. 0° warmer than usual for September.'}
  </p>
  <section class="ahead hold" aria-labelledby="week-h">
    <h3 id="week-h">{COPY.nextDays}</h3>
    <ul class="days" id="week-days" set:html={week ? weekHtml(week) : placeholderDays} />
  </section>
</section>
