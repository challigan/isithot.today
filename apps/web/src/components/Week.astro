---
/** The This week view: today and the next six days, with one row per day. */
import type { WeekDisplay } from '@isithot/core';
import { glyphFor, weekHtml } from '../lib/view';

interface Props {
  /** From core `viewDisplay`. */
  view: WeekDisplay;
}

const { view } = Astro.props;
---

<section
  class="view view-week"
  id="view-week"
  role="tabpanel"
  aria-labelledby="tab-week"
  data-view="week"
  data-band={view.band ?? undefined}
  data-empty={view.empty ? '' : undefined}
  tabindex="0"
  inert
  hidden
>
  <svg
    class="glyph"
    id="week-glyph"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={glyphFor(view.band)}
  />
  <p class="question" id="week-question">
    {view.question}
  </p>
  <h2 class="answer" id="week-answer">
    {view.answer}
  </h2>
  <p class="verdict hold" id="week-verdict">
    {view.verdict}
  </p>
  <p class="detail hold" id="week-detail">
    {view.detail}
  </p>
  <section class="ahead hold" aria-labelledby="week-h">
    <h2 id="week-h">{view.heading}</h2>
    <ul class="days" id="week-days" set:html={weekHtml(view.items)} />
  </section>
</section>
