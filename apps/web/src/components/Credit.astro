---
/**
 * A data credit from copy.ts (`ATTRIBUTION`, as the API gives it) with its source and licence
 * linked: "Weather data by Open-Meteo.com" to Open-Meteo, as its licence asks, and each licence to
 * its text (core `creditParts`, which the apps' footers use too). Link text goes in with
 * set:text: as a child, Prettier's line breaks would put spaces inside the link.
 */
import { creditParts } from '@isithot/core';

interface Props {
  text: string;
}

const parts = creditParts(Astro.props.text);
---

{parts.map((part) =>
  part.url ? <a href={part.url} rel="noopener" set:text={part.text} /> : part.text,
)}
