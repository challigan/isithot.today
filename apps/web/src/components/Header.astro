---
import {
  COPY,
  SITES,
  UNITS_LABELS,
  UNIT_NAMES,
  WIND_UNITS,
  WIND_UNIT_NAMES,
  type Topic,
  type Units,
  type WindUnit,
} from '@isithot/core';

interface Props {
  placeName?: string | null;
  units?: Units;
  /** The wind site's setting of its own (mph | km/h), or null to leave it unchosen. */
  windUnit?: WindUnit | null;
  controls?: boolean;
  /** The site the page belongs to. The browser switches the brand to the topic on screen. */
  site?: Topic;
}
const {
  placeName = null,
  units = 'c',
  windUnit = null,
  controls = true,
  site = 'hot',
} = Astro.props;
const [brand, tld] = SITES[site].name.split('.');
/**
 * Two buttons whose values follow the question on screen (scripts/app.ts swaps them). One setting
 * serves hot, wet and snow: °C goes with millimetres and centimetres, °F with inches. Wind has its
 * own, mph | km/h.
 */
const choices =
  site === 'wind'
    ? WIND_UNITS.map((u) => ({ value: u, name: WIND_UNIT_NAMES[u], pressed: u === windUnit }))
    : (['c', 'f'] as const).map((u) => ({
        value: u,
        name: UNIT_NAMES[site][u],
        pressed: u === units,
      }));
---

<header>
  <!-- prettier-ignore -->
  <a class="brand" id="brand" href="/">{brand}<span>.{tld}</span></a>
  {controls && (
    <div class="where">
      <div class="where-row">
        <button class="pill place" id="place-btn" type="button" aria-haspopup="dialog">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          <span id="place">{placeName ?? COPY.locating}</span>
          <span class="sr-only">, {COPY.changeLocation}</span>
        </button>
        <div class="pill units" role="group" aria-label={UNITS_LABELS[site]}>
          {choices.map((c) => (
            <button type="button" data-units={c.value} aria-pressed={c.pressed ? 'true' : 'false'}>
              {c.name}
            </button>
          ))}
        </div>
      </div>
      <p class="place-note" id="place-note" hidden />
    </div>
  )}
</header>
