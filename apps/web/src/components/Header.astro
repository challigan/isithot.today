---
import { COPY, SITES, type Topic, type Units } from '@isithot/core';

interface Props {
  placeName?: string | null;
  units?: Units;
  controls?: boolean;
  /** The site the page belongs to: the brand is that domain, whatever the toggle shows. */
  site?: Topic;
}
const { placeName = null, units = 'c', controls = true, site = 'hot' } = Astro.props;
const [brand, tld] = SITES[site].name.split('.');
// The same setting serves both topics: °C goes with millimetres, °F with inches.
const wet = site === 'wet';
---

<header>
  <a class="brand" href="/">
    {brand}
    <span>.{tld}</span>
  </a>
  {controls && (
    <div class="where">
      <div class="where-row">
        <button class="pill place" id="place-btn" type="button" aria-haspopup="dialog">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          <span id="place">{placeName ?? COPY.locating}</span>
          <span class="sr-only">, {COPY.changeLocation}</span>
        </button>
        <div
          class="pill units"
          role="group"
          aria-label={wet ? COPY.rainUnitsLabel : COPY.unitsLabel}
        >
          <button type="button" data-units="c" aria-pressed={units === 'c' ? 'true' : 'false'}>
            {wet ? 'mm' : '°C'}
          </button>
          <button type="button" data-units="f" aria-pressed={units === 'f' ? 'true' : 'false'}>
            {wet ? 'in' : '°F'}
          </button>
        </div>
      </div>
      <p class="place-note" id="place-note" hidden />
    </div>
  )}
</header>
