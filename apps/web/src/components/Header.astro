---
import { COPY, type Units } from '@isithot/core';

interface Props {
  placeName?: string | null;
  units?: Units;
  controls?: boolean;
}
const { placeName = null, units = 'c', controls = true } = Astro.props;
---

<header>
  <a class="brand" href="/">
    isithot<span>.today</span>
  </a>
  {controls && (
    <div class="where">
      <div class="where-row">
        <button class="pill place" id="place-btn" type="button" aria-haspopup="dialog">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          <span id="place">{placeName ?? COPY.locating}</span>
          <span class="sr-only">, {COPY.changeLocation}</span>
        </button>
        <div class="pill units" role="group" aria-label={COPY.unitsLabel}>
          <button type="button" data-units="c" aria-pressed={units === 'c' ? 'true' : 'false'}>
            °C
          </button>
          <button type="button" data-units="f" aria-pressed={units === 'f' ? 'true' : 'false'}>
            °F
          </button>
        </div>
      </div>
      <p class="place-note" id="place-note" hidden />
    </div>
  )}
</header>
