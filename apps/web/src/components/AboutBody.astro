---
/** The About page of each site: how all four questions are answered, the site's own first. */
import Content from '../layouts/Content.astro';
import AboutHot from './AboutHot.astro';
import AboutSnow from './AboutSnow.astro';
import AboutWet from './AboutWet.astro';
import AboutWind from './AboutWind.astro';
import Credit from './Credit.astro';
import { COPY, MODELS, SITES, TOPICS, type Topic } from '@isithot/core';
import { siteNames } from '../lib/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const site = SITES[topic].name;
const intro: Record<Topic, string> = {
  hot: 'will today feel hot where you are? Here is how we get from a pile of forecasts to a single Yes, Almost or No.',
  wet: 'will it rain where you are today? Here is how we get from a pile of forecasts to a single Yes, Maybe or No.',
  snow: 'will it snow where you are today? Here is how we get from a pile of forecasts to a single Yes, Maybe or No.',
  wind: 'will it be windy where you are today? Here is how we get from a pile of forecasts to a single Yes, A bit or No.',
};
const description: Record<Topic, string> = {
  hot: `How ${site} blends several forecast models and judges hot against what is normal for your place and time of year.`,
  wet: `How ${site} blends several forecast models into one answer about rain: how likely it is, how much and when.`,
  snow: `How ${site} blends several forecast models into one answer about snow: how likely it is, how much and when.`,
  wind: `How ${site} blends several forecast models into one answer about wind: how strong the wind and gusts get, and when.`,
};
/** How each question is answered, the page's own first. */
const SECTIONS = { hot: AboutHot, wet: AboutWet, snow: AboutSnow, wind: AboutWind };
const order = [topic, ...TOPICS.filter((t) => t !== topic)];
/** Who runs each forecast model, for the credits: "NOAA (GFS)". */
const AGENCIES: Record<string, string> = {
  ecmwf_ifs025: 'ECMWF',
  ncep_gfs_seamless: 'NOAA',
  dwd_icon_seamless: 'DWD',
  ukmo_seamless: 'the Met Office',
  meteofrance_seamless: 'Météo-France',
  cmc_gem_seamless: 'Environment and Climate Change Canada',
};
const agencies = MODELS.map((m) => {
  const agency = AGENCIES[m.id] ?? m.name;
  return agency === m.name ? agency : `${agency} (${m.name})`;
});
const agencyList = `${agencies.slice(0, -1).join(', ')} and ${agencies.at(-1)}`;
---

<Content title="How it works" path="/about" description={description[topic]} topic={topic}>
  <h1>How it works</h1>
  <p>
    {site} answers one question: {intro[topic]}
  </p>
  <p>
    {siteNames(topic)} are one service with four questions: will today feel hot, will it rain, will
    it snow, and will it be windy? Each site opens on its own question, and the Hot, Wet, Snow and
    Wind switch at the top of the page swaps between them.
  </p>

  {order.map((t) => {
    const Section = SECTIONS[t];
    return <Section />;
  })}

  <h2>Your location</h2>
  <p>
    We start with an approximate location from your internet connection. If you allow it, your
    device location is used instead, rounded to about 5 km before it leaves your browser. You can
    also search for any place. Read more in our <a href="/privacy">privacy notice</a>.
  </p>

  <h2>Data sources</h2>
  <p>
    The forecasts come from {MODELS.length} models run by {agencyList}, through Open-Meteo. We
    combine and modify them: the blended figures and the answers are our own work, not the weather
    services'.
  </p>
  <ul>
    <li>
      <Credit text={COPY.forecastCredit} />.
    </li>
    <li>
      <Credit text={COPY.metOfficeCredit} />.
    </li>
    <!-- prettier-ignore -->
    <li>Climate normals: <a href="https://power.larc.nasa.gov/" rel="noopener">NASA POWER</a> (Prediction Of Worldwide Energy Resources), long-term monthly averages of daily highs, rainfall, snowfall and wind speed, from the NASA Langley Research Center (LaRC) POWER Project and licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>. In NASA's words, "There are no restrictions on the use, access, and/or download of data from the NASA POWER Project."</li>
    <!-- prettier-ignore -->
    <li>Place names: <a href="https://www.geonames.org/" rel="noopener">GeoNames</a>, licensed under CC BY 4.0.</li>
  </ul>
  <p>
    Forecasts are estimates. For anything that matters, like heat health, flood or wind warnings,
    check your national weather service.
  </p>
</Content>
