---
/**
 * A city's page on any of the sites (isithot.today/in/<slug>, isitwet.today/in/<slug>,
 * willitsnow.today/in/<slug>), rendered on the server with the answer to that site's question: the
 * question, answer, colours and icon are right before any script runs. lib/cityPage.ts handles
 * the request. A snow page for a place where it never snows works but is kept out of search
 * engines (core `listed`).
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Views from './Views.astro';
import AdSlot from './AdSlot.astro';
import Footer from './Footer.astro';
import SearchSheet from './SearchSheet.astro';
import NotFound from './NotFound.astro';
import CityLinks from './CityLinks.astro';
import { SITES, cityDescription, cityTitle, listed } from '@isithot/core';
import type { CityPageProps } from '../lib/cityPage';
import { breadcrumbLd } from '../lib/seo';
import { SHARE_TITLES } from '../lib/topics';

type Props = CityPageProps;

const { topic, city, units, data, state, today, start, tomorrow, palette } = Astro.props;
const site = SITES[topic];
const name = city?.name ?? '';

// Search results show the title and description long after the page was made, so they say what
// the page answers, never the answer. Share cards carry today's answer, as the page does, whichever
// view it opens on.
const title = cityTitle(name, topic);
const description = cityDescription(name, topic);
const shareTitle = (data && SHARE_TITLES[topic](name, data)) || title;
const shareDescription = today.band ? `${today.verdict} ${today.detail}` : description;
const initial = JSON.stringify(data).replace(/</g, '\\u003c');
---

{city ? (
  <Base
    title={title}
    description={description}
    ogTitle={shareTitle}
    ogDescription={shareDescription}
    canonical={`${site.url}/in/${city.slug}`}
    ogImage={`${site.url}/og/${city.slug}.png`}
    palette={palette}
    noindex={!listed(city, topic)}
    jsonLd={breadcrumbLd(topic, city)}
    topic={topic}
  >
    <div
      class="wrap"
      id="app"
      data-state={state}
      data-mode="city"
      data-slug={city.slug}
      data-topic={topic}
    >
      <Header placeName={city.name} units={units} site={topic} />
      <Views
        data={data}
        city={city.name}
        state={state}
        topic={topic}
        start={start}
        tomorrow={tomorrow}
      >
        <CityLinks topic={topic} city={city} />
      </Views>
      <AdSlot />
      <Footer />
    </div>
    <SearchSheet />
    <script type="application/json" id="initial" set:html={initial} />
    <script>
      import { start } from '../scripts/app';
      start();
    </script>
  </Base>
) : (
  <NotFound topic={topic} />
)}
