---
/**
 * A city's page on any of the sites (isithot.today/in/<slug>, isitwet.today/in/<slug>,
 * willitsnow.today/in/<slug>), rendered on the server with the answer to that site's question: the
 * question, answer, colours and icon are right before any script runs. lib/cityPage.ts handles
 * the request.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Views from './Views.astro';
import AdSlot from './AdSlot.astro';
import Footer from './Footer.astro';
import SearchSheet from './SearchSheet.astro';
import NotFound from './NotFound.astro';
import { SITES, question, type Topic } from '@isithot/core';
import type { CityPageProps } from '../lib/cityPage';
import { CITY_TITLES } from '../lib/topics';

type Props = CityPageProps;

const { topic, city, units, data, state, today, start, tomorrow, palette } = Astro.props;
const site = SITES[topic];
const name = city?.name ?? '';

/** Without an answer, what the page is for. */
const ABOUT: Record<Topic, string> = {
  hot: `Will today feel hot in ${name}? One answer from several forecast models, judged against what is normal there.`,
  wet: `Will it rain in ${name} today? One answer from several forecast models: how likely rain is, how much and when.`,
  snow: `Will it snow in ${name} today? One answer from several forecast models: how likely snow is, how much and when.`,
};

// The title and description are about today, whichever view the page opens on.
const answerTitle = data && CITY_TITLES[topic](name, data);
const title = answerTitle || `${question(name, 'today', topic)} | ${site.name}`;
const description = today.band ? `${today.verdict} ${today.detail}` : ABOUT[topic];
const initial = JSON.stringify(data).replace(/</g, '\\u003c');
---

{city ? (
  <Base
    title={title}
    description={description}
    canonical={`${site.url}/in/${city.slug}`}
    ogImage={`${site.url}/og/${city.slug}.png`}
    palette={palette}
    topic={topic}
  >
    <div
      class="wrap"
      id="app"
      data-state={state}
      data-mode="city"
      data-slug={city.slug}
      data-topic={topic}
    >
      <Header placeName={city.name} units={units} site={topic} />
      <Views
        data={data}
        city={city.name}
        state={state}
        topic={topic}
        start={start}
        tomorrow={tomorrow}
      />
      <AdSlot />
      <Footer />
    </div>
    <SearchSheet />
    <script type="application/json" id="initial" set:html={initial} />
    <script>
      import { start } from '../scripts/app';
      start();
    </script>
  </Base>
) : (
  <NotFound topic={topic} />
)}
