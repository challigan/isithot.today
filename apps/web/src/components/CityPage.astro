---
/**
 * A city's page on either site, isithot.today/in/<slug> or isitwet.today/in/<slug>, rendered on
 * the server with the answer to that site's question: the question, answer, colours and icon
 * are right before any script runs. lib/cityPage.ts handles the request.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Views from './Views.astro';
import AdSlot from './AdSlot.astro';
import Footer from './Footer.astro';
import SearchSheet from './SearchSheet.astro';
import NotFound from './NotFound.astro';
import { SITES, pageTitle, question, wetPageTitle } from '@isithot/core';
import type { CityPageProps } from '../lib/cityPage';

type Props = CityPageProps;

const { topic, city, units, data, state, today } = Astro.props;
const site = SITES[topic];
const name = city?.name ?? '';
const day = data?.days[0];
const rainDay = data?.rain?.days[0];

const answerTitle =
  topic === 'wet'
    ? rainDay && wetPageTitle({ city: name, answer: rainDay.answer, band: rainDay.band })
    : day && pageTitle({ city: name, answer: day.answer, high: day.high });
const title = answerTitle || `${question(name, 'today', topic)} | ${site.name}`;
const description = today.band
  ? `${today.verdict} ${today.detail}`
  : topic === 'wet'
    ? `Will it rain in ${name} today? One answer from several forecast models: how likely rain is, how much and when.`
    : `Will today feel hot in ${name}? One answer from several forecast models, judged against what is normal there.`;
const initial = JSON.stringify(data).replace(/</g, '\\u003c');
---

{city ? (
  <Base
    title={title}
    description={description}
    canonical={`${site.url}/in/${city.slug}`}
    ogImage={`${site.url}/og/${city.slug}.png`}
    palette={today.palette}
    topic={topic}
  >
    <div
      class="wrap"
      id="app"
      data-state={state}
      data-mode="city"
      data-slug={city.slug}
      data-topic={topic}
    >
      <Header placeName={city.name} units={units} site={topic} />
      <Views data={data} city={city.name} state={state} topic={topic} />
      <AdSlot />
      <Footer />
    </div>
    <SearchSheet />
    <script type="application/json" id="initial" set:html={initial} />
    <script>
      import { start } from '../scripts/app';
      start();
    </script>
  </Base>
) : (
  <NotFound topic={topic} />
)}
