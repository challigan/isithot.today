---
/** "Lost." Each site's not-found page, with its own name, question and colours. */
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { HERE_QUESTIONS, SITES, type Topic } from '@isithot/core';
import { LOOKS } from '../lib/topics';

interface Props {
  topic?: Topic;
}
const { topic = 'hot' } = Astro.props;
const [brand, tld] = SITES[topic].name.split('.');
---

<Base
  title={`Not found | ${SITES[topic].name}`}
  palette={LOOKS[topic].notFound}
  topic={topic}
  noindex
>
  <div class="wrap" data-topic={topic}>
    <header>
      <!-- prettier-ignore -->
      <a class="brand" href="/">{brand}<span>.{tld}</span></a>
    </header>
    <main id="main">
      <p class="question">{HERE_QUESTIONS[topic]}</p>
      <h1 class="answer">Lost.</h1>
      <p class="verdict">We can't find that page.</p>
      <p class="detail">
        <a href="/" style="color: inherit">
          See today's answer for where you are.
        </a>
      </p>
    </main>
    <Footer />
  </div>
</Base>
