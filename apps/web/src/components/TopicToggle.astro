---
/**
 * Hot | Wet | Snow | Wind. Pages open on their own site's topic (isithot.today on Hot,
 * isitwet.today on Wet, willitsnow.today on Snow, isitwindy.today on Wind); pressing another
 * re-renders the same views in place (scripts/app.ts). Above the tab bar from 640px up; on phones
 * it floats at the bottom of the screen, in thumb reach (styles/global.css), while staying first
 * in the markup so the question still comes before the period. Each button's icon comes and goes,
 * or moves above its word, with the room there is.
 */
import { COPY, TOPICS, TOPIC_LABELS, type Topic } from '@isithot/core';
import { TOPIC_ICONS } from '../lib/wetGlyphs';

interface Props {
  /** The topic the page opens on. */
  topic: Topic;
}

const { topic } = Astro.props;
---

<div class="pill topic" id="topic" role="group" aria-label={COPY.topicLabel}>
  {TOPICS.map((t) => (
    <button type="button" data-topic={t} aria-pressed={t === topic ? 'true' : 'false'}>
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={TOPIC_ICONS[t]}
      />
      {TOPIC_LABELS[t]}
    </button>
  ))}
</div>
