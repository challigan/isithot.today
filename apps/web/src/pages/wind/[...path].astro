---
/**
 * Any other path on isitwindy.today (the edge function serves every path from under /wind): the
 * wind not-found page. The site's own pages and files under /wind take precedence over this.
 */
import NotFound from '../../components/NotFound.astro';

export const prerender = false;

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<NotFound topic="wind" />
