---
/**
 * Any other path on willitsnow.today (the edge function serves every path from under /snow): the
 * snow not-found page. The site's own pages and files under /snow take precedence over this.
 */
import NotFound from '../../components/NotFound.astro';

export const prerender = false;

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<NotFound topic="snow" />
