---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import { SITES, type Topic } from '@isithot/core';
import { LOOKS } from '../lib/topics';

interface Props {
  title: string;
  description: string;
  /** The page's path on its site, e.g. "/about". */
  path: string;
  /** The site the page belongs to. */
  topic?: Topic;
  /** Structured data for search engines (lib/seo.ts). */
  jsonLd?: object;
}
const { title, description, path, topic = 'hot', jsonLd } = Astro.props;
const site = SITES[topic];
const [brand, tld] = site.name.split('.');
---

<Base
  title={`${title} | ${site.name}`}
  description={description}
  canonical={`${site.url}${path}`}
  palette={LOOKS[topic].content}
  jsonLd={jsonLd}
  topic={topic}
>
  <div class="wrap" data-topic={topic}>
    <header>
      <!-- prettier-ignore -->
      <a class="brand" href="/">{brand}<span>.{tld}</span></a>
    </header>
    <main id="main" class="prose" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </div>
</Base>
