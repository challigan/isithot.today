# Copy to apps/web/.env for local development. In production set these in
# Netlify: Project configuration > Environment variables. Never commit real values.

# Open-Meteo Standard plan key. With a key, the paid customer-api hosts are used
# automatically. Required before ads or any public launch (the free API bans commercial use).
OPEN_METEO_API_KEY=

# Optional overrides for the upstream hosts.
# OPEN_METEO_FORECAST_URL=https://customer-api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODING_URL=https://customer-geocoding-api.open-meteo.com/v1/search
# NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/climatology/point

# "synthetic" serves made-up data in the real formats, for offline development and tests.
# DATA_SOURCE=synthetic

# City page slug used when a visitor's approximate location is unknown.
# FALLBACK_PLACE=london-gb

# Ads (off until AdSense approval and the paid Open-Meteo plan).
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# AdMob publisher ID for the apps (pub-…): generates /app-ads.txt on every domain.
PUBLIC_ADMOB_PUBLISHER_ID=

# Cloudflare Web Analytics token (cookieless page view counts).
PUBLIC_CF_BEACON_TOKEN=
